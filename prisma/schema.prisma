datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  emails    String   // Comma-separated list of email addresses in the group
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model TaskType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id                 Int        @id @default(autoincrement())
  title              String
  description        String
  status             String     @default("IN_PROGRESS") // IN_PROGRESS, HOLD, COMPLETED
  dueDate            DateTime
  taskTypeId         Int
  taskType           TaskType   @relation(fields: [taskTypeId], references: [id], onDelete: Restrict)
  reminderDaysBefore Int        @default(1) // Number of days before due date to remind (e.g. 1, 2)
  reminderSentAt     DateTime?  // Timestamp when the reminder email was successfully sent
  reminderAt         DateTime?
  dueEmailSentAt     DateTime?
  completionToken    String     @unique @default(uuid())
  completedByEmail   String?
  assigneeEmails     String?    // Comma-separated list of individual email addresses to remind
  userGroupId        Int?
  userGroup          UserGroup? @relation(fields: [userGroupId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model KPI {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  target      Float      // Overall or annual target value
  unit        String     // e.g. "%", "hours", "count", "LKR"
  frequency   String     @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  values      KPIValue[]
}

model KPIValue {
  id          Int      @id @default(autoincrement())
  kpiId       Int
  kpi         KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  period      String   // e.g. "2026-07" for July 2026 or "2026-Q1" for Q1 2026
  targetValue Float
  actualValue Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kpiId, period])
}

model Person {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VirtualAssessorJob {
  id             Int      @id @default(autoincrement())
  sourceKey      String   @unique
  referenceNo    String
  description    String?
  customerName   String?
  customerMobile String?
  product        String?
  agentId        String
  agentName      String?
  latitude       Float?
  longitude      Float?
  status         String
  jobDate        DateTime
  cancelReason   String?
  sourceFile     String?
  uploadedAt     DateTime @default(now())

  @@index([jobDate])
  @@index([status])
  @@index([agentId])
}

model DmsUser {
  id             Int      @id @default(autoincrement())
  externalUserId String?
  userName       String?
  email          String?
  status         String
  sourceFile     String?
  uploadedAt     DateTime @default(now())

  @@index([externalUserId])
  @@index([status])
}

model DmsIndexEntry {
  id            Int      @id @default(autoincrement())
  userId        String
  documentCount Int
  month         String
  sourceFile    String?
  uploadedAt    DateTime @default(now())

  @@index([month])
  @@index([userId])
}

model SalvageStockEntry {
  id          Int      @id @default(autoincrement())
  entryDate   DateTime
  itemCode    String
  itemName    String
  stockUom    String?
  inQty       Int
  outQty      Int
  balanceQty  Int
  warehouse   String
  itemGroup   String?
  voucherType String?
  voucherNo   String?
  sourceFile  String?
  uploadedAt  DateTime @default(now())

  @@index([entryDate])
  @@index([warehouse])
}

model SalvageLoginUser {
  id          Int       @id @default(autoincrement())
  userName    String
  email       String
  lastLoginAt DateTime?
  ipAddress   String?
  sourceFile  String?
  uploadedAt  DateTime  @default(now())

  @@index([email])
  @@index([lastLoginAt])
}
